# Copy to .env and fill in. Never commit .env.
# true = deterministic replay of PayPal / Channel3 / LLM (demo-safe). Set false to hit real sandboxes.
REPLAY_MODE=true

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_VAULT_ID=
# Lets a replay deployment offer one real PayPal sandbox run from a button (needs the three PayPal values above and a
# vault id). Off by default. Each run charges the saved wallet (test money); capped by SANDBOX_RUN_BUDGET_CAP (USD) and
# limited to SANDBOX_RUNS_PER_HOUR across all visitors, and 3 an hour per visitor.
ALLOW_SANDBOX_RUNS=false
SANDBOX_RUN_BUDGET_CAP=2500
SANDBOX_RUNS_PER_HOUR=12

CHANNEL3_API_KEY=          # promo code PAYPAL-HACKATHON-2026
CHANNEL3_BASE_URL=https://api.trychannel3.com

ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

LEDGER_PATH=./ledger.db
GATE_SECRET=change-me-to-a-long-random-string

# Returns address for "refund on return" dispute offers. PayPal shows it to the buyer; required in live mode.
RETURN_ADDRESS_LINE_1=
RETURN_ADDRESS_CITY=
RETURN_ADDRESS_STATE=
RETURN_ADDRESS_POSTAL_CODE=
RETURN_ADDRESS_COUNTRY=US

# Browser origins allowed to call the API from another host (the Vite dev servers). Not needed when the API serves the frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Folder of the built frontend. Set it (e.g. ../frontend/dist) and the API serves the UI at "/". The Dockerfile sets this.
FRONTEND_DIST=
