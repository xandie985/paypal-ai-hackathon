# Copy to .env and fill in. Never commit .env.
# true = deterministic replay of PayPal / Channel3 / LLM (demo-safe). Set false to hit real sandboxes.
REPLAY_MODE=true

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_VAULT_ID=

CHANNEL3_API_KEY=          # promo code PAYPAL-HACKATHON-2026
CHANNEL3_BASE_URL=https://api.trychannel3.com

ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

LEDGER_PATH=./ledger.db
GATE_SECRET=change-me-to-a-long-random-string

# Returns address for "refund on return" dispute offers. PayPal shows it to the buyer; required in live mode.
RETURN_ADDRESS_LINE_1=
RETURN_ADDRESS_CITY=
RETURN_ADDRESS_STATE=
RETURN_ADDRESS_POSTAL_CODE=
RETURN_ADDRESS_COUNTRY=US
